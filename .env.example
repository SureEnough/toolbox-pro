# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys

# Secret key (sk_test_... for test mode, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook signing secret (from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs for subscription plans (create in Stripe Dashboard > Products)
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_YEARLY=price_your_yearly_price_id

# Google Analytics (optional)
GA_MEASUREMENT_ID=G-XXXXXXXXXX
